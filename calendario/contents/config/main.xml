<?xml version="1.0" encoding="UTF-8"?>
<!-- Las mismas claves que el reloj de KDE (org.kde.plasma.digitalclock): al cambiar de plasmoide se conserva su
     configuración, y Ajustes → Barra de menús → Opciones del reloj sigue funcionando -->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="Appearance">
    <entry name="showDate" type="Bool"><default>true</default></entry>
    <entry name="dateFormat" type="String"><default>custom</default></entry>
    <entry name="customDateFormat" type="String"><default>ddd d MMM</default></entry>
    <entry name="dateDisplayFormat" type="String"><default>BesideTime</default></entry>
    <entry name="use24hFormat" type="Int"><default>2</default></entry>
    <entry name="showSeconds" type="Int"><default>0</default></entry>
    <entry name="autoFontAndSize" type="Bool"><default>false</default></entry>
    <entry name="fontFamily" type="String"><default>Inter</default></entry>
    <entry name="fontSize" type="Int"><default>10</default></entry>
    <entry name="fontWeight" type="Int"><default>600</default></entry>
    <entry name="boldText" type="Bool"><default>false</default></entry>
  </group>
</kcfg>
