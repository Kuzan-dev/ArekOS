#!/usr/bin/env python3
import sys
import os

# Add parent directory to sys.path so package can be imported directly
current_dir = os.path.dirname(os.path.abspath(__file__))
if current_dir not in sys.path:
    sys.path.insert(0, current_dir)

from vitrum_icon_patcher.main import main

if __name__ == "__main__":
    sys.exit(main())
